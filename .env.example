# Copy to .env and replace placeholders locally; never commit actual credentials.
# Supply these variables to the API/ingestion process at runtime. load_settings()
# reads process environment only. compose.yaml passes this file to the API at
# runtime. Never use secrets as build args.
# For local backend commands from the repository root (trusted .env files only):
# set -a; . ./.env; set +a
# cd backend && .venv/bin/python ...

# SQLAlchemy psycopg URL; percent-encode special characters in credentials.
# db is the Compose hostname; use localhost for a local PostgreSQL instance.
# POSTGRES_PASSWORD initializes the database. Its value must match the password
# inside DATABASE_URL below (URL-encode it there if it has special characters).
# Changing this variable later does NOT change a password in an existing volume.
POSTGRES_PASSWORD=replace-with-local-password
DATABASE_URL='postgresql+psycopg://pnw:replace-with-local-password@db:5432/pnw'
DATABASE_TIMEOUT_SECONDS=2

# Provider-neutral identifiers: select the adapter/models supplied by deployment.
# These are placeholders, not working provider credentials or model choices.
AI_PROVIDER=replace-with-provider
AI_API_KEY=replace-with-provider-key
AI_GENERATION_MODEL=replace-with-generation-model
AI_EMBEDDING_MODEL=replace-with-embedding-model
# Version identifies your embedding configuration; dimension must match model output.
# Model/version/dimension changes require rebuilding compatible chunk embeddings.
EMBEDDING_VERSION=v1
EMBEDDING_DIMENSION=768

# Chunk sizes in characters; 0 <= overlap < size.
CHUNK_SIZE=800
CHUNK_OVERLAP=100
# Positive finite seconds. AI timeout bounds each provider call; the 10-second
# end-to-end latency target still needs measurement and a shared request budget.
AI_TIMEOUT_SECONDS=6
SOURCE_TIMEOUT_SECONDS=10
OIDC_TIMEOUT_SECONDS=3

# Obtain the exact HTTPS issuer and API audience from the PNW OIDC administrator.
# Do not substitute a production identity provider for deterministic test doubles.
OIDC_ISSUER=https://replace-with-pnw-issuer.example.edu
OIDC_AUDIENCE=replace-with-api-audience

# JSON list of exact browser origins, without trailing slashes or paths; no '*'.
# Empty list denies cross-origin requests and supports a same-origin /api proxy.
# Local Vite example: '["http://localhost:5173"]'
CORS_ORIGINS='[]'

# T012: anonymous per-process API budget (no per-IP or student tracking).
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
# JSON array of trusted reverse-proxy IPs/CIDRs. Empty means no proxy trust.
# Configure only the proxy address/subnet; never trust all addresses.
TRUSTED_PROXY_NETWORKS=[]
# Set true for TLS deployments after configuring trusted proxies.
# /api/health stays accessible over the private HTTP health-check connection.
REQUIRE_HTTPS=false

# T013: provision the actual PNW identity provider's HTTPS JWKS endpoint.
# Omit OIDC_JWKS_URL until configured; reviewer authentication then fails closed.
# OIDC_JWKS_URL=https://YOUR-PNW-ISSUER/keys
OIDC_ROLES_CLAIM=roles
# Map verified token role values to exact owning-office names. Empty denies review.
OIDC_OFFICE_ROLES={}
